model LedgerGroup {
  id        String        @id @default(uuid())
  companyId String
  name      String
  nature    LedgerNature
  isSystem  Boolean       @default(false)
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ledgers   Ledger[]
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    LedgerGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children  LedgerGroup[] @relation("GroupHierarchy")

  @@unique([companyId, name])
  @@index([companyId])
}

model Ledger {
  id                 String        @id @default(uuid())
  companyId          String
  name               String
  groupId            String
  openingBalance     Decimal       @default(0) @db.Decimal(14, 2)
  openingBalanceType EntryType     @default(DEBIT)
  description        String?
  isSystem           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  bankAccount        BankAccount?
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group              LedgerGroup   @relation(fields: [groupId], references: [id])
  party              Party?
  voucherLines       VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([groupId])
}
