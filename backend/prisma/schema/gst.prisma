// GST return JSON exports. Invoices/notes are never copied here — only the
// generated files (so a download always returns exactly what was generated,
// even if source documents change later) and the validation outcome.
model GstExportHistory {
  id              String          @id @default(uuid())
  companyId       String
  returnType      String          // GSTR1 | IFF
  frequency       String          // MONTHLY | QUARTERLY
  financialYear   String          // "2026-27"
  returnPeriod    String          // GST fp, MMYYYY
  periodLabel     String
  gstin           String
  toolVersion     String          // "version" written into the JSON, e.g. GST3.2.4
  schemaId        String          // bundled JSON Schema the files were validated against
  recordCount     Int
  excludedCount   Int             @default(0)
  warningCount    Int             @default(0)
  fileCount       Int
  totalSizeBytes  Int
  status          String          // SCHEMA_VALID
  summary         Json            // counts + totals shown in the preview
  issues          Json            // validation issues at generation time (error report)
  createdById     String?
  createdAt       DateTime        @default(now())
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation(fields: [createdById], references: [id])
  files           GstExportFile[]

  @@index([companyId, createdAt])
  @@index([companyId, returnType, returnPeriod])
}

model GstExportFile {
  id         String           @id @default(uuid())
  exportId   String
  partNo     Int
  fileName   String
  sizeBytes  Int
  sha256     String
  content    String           @db.Text
  export     GstExportHistory @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@unique([exportId, partNo])
}
