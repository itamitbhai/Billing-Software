model FinancialYear {
  id        String            @id @default(uuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean           @default(false)
  isClosed  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  vouchers  Voucher[]
  sequences VoucherSequence[]

  @@unique([companyId, name])
  @@index([companyId])
}

model VoucherSequence {
  id              String        @id @default(uuid())
  companyId       String
  financialYearId String
  type            VoucherType
  lastNumber      Int           @default(0)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([companyId, financialYearId, type])
}

model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  voucherNumber   String
  type            VoucherType
  date            DateTime
  narration       String?
  partyId         String?
  financialYearId String
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payment         Payment?
  purchase        Purchase?
  sale            Sale?
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  party           Party?        @relation(fields: [partyId], references: [id])
  lines           VoucherLine[]

  @@unique([companyId, type, voucherNumber])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([partyId])
}

model VoucherLine {
  id             String              @id @default(uuid())
  voucherId      String
  ledgerId       String
  type           EntryType
  amount         Decimal             @db.Decimal(14, 2)
  cgstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  costCentreId   String?
  description    String?
  createdAt      DateTime            @default(now())
  reconciliation BankReconciliation?
  costCentre     CostCentre?         @relation(fields: [costCentreId], references: [id])
  ledger         Ledger              @relation(fields: [ledgerId], references: [id])
  voucher        Voucher             @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([ledgerId])
}
