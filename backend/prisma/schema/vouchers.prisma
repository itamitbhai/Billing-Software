// ============================================
// vouchers.prisma - Double Entry Vouchers
// ============================================

model FinancialYear {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isClosed  Boolean  @default(false) // blocks new postings once the year is closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers  Voucher[]
  sales     Sale[]
  purchases Purchase[]
  sequences VoucherSequence[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Atomic per-(company, financial year, type) counter — avoids the
// count()-then-pad race condition that produced duplicate voucher numbers.
model VoucherSequence {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  type            VoucherType
  lastNumber      Int           @default(0)

  @@unique([companyId, financialYearId, type])
}

model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherNumber   String
  type            VoucherType
  date            DateTime
  narration       String?
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  isDeleted Boolean   @default(false) // cancelled, never hard-deleted
  deletedAt DateTime?
  deletedBy String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    VoucherLine[]
  sale     Sale?
  purchase Purchase?
  payment  Payment?

  @@unique([companyId, type, voucherNumber])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([partyId])
}

model VoucherLine {
  id           String      @id @default(uuid())
  voucherId    String
  voucher      Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId     String
  ledger       Ledger      @relation(fields: [ledgerId], references: [id])
  type         EntryType
  amount       Decimal     @db.Decimal(14, 2)
  cgstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  costCentreId String?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])
  description  String?
  createdAt    DateTime    @default(now())

  reconciliation BankReconciliation?

  @@index([voucherId])
  @@index([ledgerId])
}
