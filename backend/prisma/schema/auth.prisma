model Company {
  id                 String             @id @default(uuid())
  name               String
  gstin              String?
  pan                String?
  state              String
  address            String?
  phone              String?
  email              String?            @unique
  invoicePrefix      String             @default("INV")
  bankName           String?
  accountNo          String?
  ifscCode           String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dlNumber           String?
  auditLogs          AuditLog[]
  bankAccounts       BankAccount[]
  costCentres        CostCentre[]
  financialYears     FinancialYear[]
  ledgers            Ledger[]
  ledgerGroups       LedgerGroup[]
  parties            Party[]
  payments           Payment[]
  products           Product[]
  purchases          Purchase[]
  sales              Sale[]
  stockLedgerEntries StockLedgerEntry[]
  users              User[]
  vouchers           Voucher[]
  voucherSequences   VoucherSequence[]
  gstExports         GstExportHistory[]
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STAFF)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  payments     Payment[]  @relation("RecordedBy")
  sessions     Session[]
  gstExports   GstExportHistory[]
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
}
