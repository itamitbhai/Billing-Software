model Purchase {
  id              String         @id @default(uuid())
  companyId       String
  financialYearId String
  supplierId      String
  billNumber      String
  purchaseDate    DateTime
  subTotal        Decimal        @db.Decimal(14, 2)
  gstAmount       Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal        @db.Decimal(14, 2)
  voucherId       String?        @unique
  isCancelled     Boolean        @default(false)
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  reverseCharge   Boolean        @default(false)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear  @relation(fields: [financialYearId], references: [id])
  supplier        Party          @relation(fields: [supplierId], references: [id])
  voucher         Voucher?       @relation(fields: [voucherId], references: [id])
  items           PurchaseItem[]

  @@unique([companyId, supplierId, billNumber])
  @@index([companyId, purchaseDate])
  @@index([companyId, supplierId, purchaseDate])
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  batchId      String
  qty          Int
  rate         Decimal  @db.Decimal(14, 2)
  gstAmount    Decimal  @default(0) @db.Decimal(14, 2)
  amount       Decimal  @db.Decimal(14, 2)
  cgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  gstRate      Decimal  @default(0) @db.Decimal(5, 2)
  hsnCode      String?
  igstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean  @default(true)
  sgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  taxableValue Decimal  @default(0) @db.Decimal(14, 2)
  productId    String
  batch        Batch    @relation(fields: [batchId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([batchId])
  @@index([productId])
}

model Sale {
  id              String        @id @default(uuid())
  companyId       String
  financialYearId String
  customerId      String
  invoiceNumber   String
  saleDate        DateTime
  subTotal        Decimal       @db.Decimal(14, 2)
  gstAmount       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  status          InvoiceStatus @default(UNPAID)
  voucherId       String?       @unique
  isCancelled     Boolean       @default(false)
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  placeOfSupply   String        @default("")
  supplyType      SupplyType    @default(TAXABLE)
  payments        Payment[]
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Party         @relation(fields: [customerId], references: [id])
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  items           SaleItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, saleDate])
  @@index([companyId, customerId, saleDate])
  @@index([companyId, status])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  batchId      String
  qty          Int
  rate         Decimal @db.Decimal(14, 2)
  gstAmount    Decimal @default(0) @db.Decimal(14, 2)
  amount       Decimal @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  hsnCode      String?
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  productId    String
  batch        Batch   @relation(fields: [batchId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([batchId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  partyId         String
  saleId          String?
  voucherId       String?       @unique
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  referenceNumber String?
  paymentDate     DateTime
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party           Party         @relation(fields: [partyId], references: [id])
  recordedBy      User?         @relation("RecordedBy", fields: [recordedById], references: [id])
  sale            Sale?         @relation(fields: [saleId], references: [id])
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])

  @@index([companyId, partyId])
  @@index([companyId, paymentDate])
  @@index([saleId])
}

model StockLedgerEntry {
  id            String             @id @default(uuid())
  companyId     String
  productId     String
  batchId       String
  movementType  StockMovementType
  referenceType StockReferenceType
  referenceId   String?
  qty           Int
  balanceQty    Int
  rate          Decimal            @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime           @default(now())
  batch         Batch              @relation(fields: [batchId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])

  @@index([companyId, productId, createdAt])
  @@index([batchId])
  @@index([referenceType, referenceId])
}
