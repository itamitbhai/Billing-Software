model Party {
  id               String     @id @default(uuid())
  companyId        String
  externalId       String?
  name             String
  gstin            String?
  pan              String?
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  type             PartyType  @default(CUSTOMER)
  creditLimit      Decimal?   @db.Decimal(14, 2)
  creditPeriodDays Int?       @default(30)
  openingBalance   Decimal    @default(0) @db.Decimal(14, 2)
  isActive         Boolean    @default(true)
  ledgerId         String     @unique
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dlNumber         String?
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger           Ledger     @relation(fields: [ledgerId], references: [id])
  payments         Payment[]
  purchases        Purchase[]
  sales            Sale[]
  vouchers         Voucher[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, gstin])
}

model Product {
  id                 String             @id @default(uuid())
  companyId          String
  externalId         String?
  name               String
  sku                String?
  type               String?
  price              Decimal            @db.Decimal(14, 2)
  unit               String             @default("PCS")
  hsnCode            String?
  gstRate            Decimal            @default(0) @db.Decimal(5, 2)
  reorderLevel       Int                @default(0)
  isActive           Boolean            @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  batches            Batch[]
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, sku])
}

model Batch {
  id                 String             @id @default(uuid())
  companyId          String
  productId          String
  batchNumber        String
  expiryDate         DateTime
  mrp                Decimal            @db.Decimal(14, 2)
  currentQty         Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([productId, batchNumber])
  @@index([companyId, expiryDate])
}

model CostCentre {
  id           String        @id @default(uuid())
  companyId    String
  name         String
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       CostCentre?   @relation("CostCentreHierarchy", fields: [parentId], references: [id])
  children     CostCentre[]  @relation("CostCentreHierarchy")
  voucherLines VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
}
