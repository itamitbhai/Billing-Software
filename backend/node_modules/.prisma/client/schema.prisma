// ============================================
// accounts.prisma - Chart of Accounts
// ============================================

model LedgerGroup {
  id        String        @id @default(uuid())
  name      String        @unique
  nature    LedgerNature
  parentId  String?
  parent    LedgerGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children  LedgerGroup[] @relation("GroupHierarchy")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ledgers Ledger[]
}

model Ledger {
  id                 String      @id @default(uuid())
  name               String      @unique
  groupId            String
  group              LedgerGroup @relation(fields: [groupId], references: [id])
  openingBalance     Decimal     @default(0) @db.Decimal(12, 2)
  openingBalanceType EntryType   @default(DEBIT)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  party        Party?
  voucherLines VoucherLine[]
}

// ============================================
// auth.prisma - Auth & Company Settings
// ============================================

model CompanySettings {
  id            String   @id @default(uuid())
  companyName   String
  gstin         String
  state         String
  address       String?
  phone         String?
  email         String?
  bankName      String?
  accountNo     String?
  ifscCode      String?
  invoicePrefix String   @default("INV")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[] @relation("RecordedBy")
}

// ============================================================
// base.prisma — Database connection + Prisma Client config
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

// ============================================
// billing.prisma - Transactions and Payments
// ============================================

model Purchase {
  id         String @id @default(uuid())
  supplierId String
  supplier   Party  @relation(fields: [supplierId], references: [id])

  billNumber   String // supplier's own bill/invoice number
  purchaseDate DateTime
  totalAmount  Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  qty       Int
  rate      Decimal @db.Decimal(12, 2)
  gstAmount Decimal @default(0) @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2) // qty * rate + gst
}

model Sale {
  id         String @id @default(uuid())
  customerId String
  customer   Party  @relation(fields: [customerId], references: [id])

  invoiceNumber String        @unique
  saleDate      DateTime
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    SaleItem[]
  payments Payment[]

  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  qty       Int
  rate      Decimal @db.Decimal(12, 2)
  gstAmount Decimal @default(0) @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2) // qty * rate + gst
}

model Payment {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  saleId String? // nullable - advance payments have no invoice yet
  sale   Sale?   @relation(fields: [saleId], references: [id])

  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String? // UPI txn id / cheque no / bank ref
  paymentDate     DateTime
  notes           String?

  recordedById String?
  recordedBy   User?   @relation("RecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([partyId])
  @@index([saleId])
  @@index([paymentDate])
}

// ============================================
// enums.prisma - Enums for B2B Medical Billing
// ============================================

enum Role {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  RAZORPAY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum LedgerNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum EntryType {
  DEBIT
  CREDIT
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
  CREDIT_NOTE
  DEBIT_NOTE
}

// ============================================
// masters.prisma - Master data (Party, Product, Batch)
// ============================================

model Party {
  id String @id @default(uuid())

  // --- Auto-fetched from existing VS Arogya app ---
  externalId String? @unique // ID in the existing app, used to match on re-sync
  name       String
  gstin      String?
  phone      String?
  email      String?
  address    String?
  state      String?

  // --- Manual fields (billing-specific, not in existing app) ---
  type             PartyType @default(CUSTOMER)
  creditLimit      Decimal?  @db.Decimal(12, 2)
  creditPeriodDays Int?      @default(30)
  openingBalance   Decimal?  @default(0) @db.Decimal(12, 2)

  // Backing Ledger Link
  ledgerId String @unique
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchases Purchase[]
  sales     Sale[]
  payments  Payment[]

  @@index([gstin])
  @@index([name])
}

model Product {
  id String @id @default(uuid())

  // --- Auto-fetched from existing VS Arogya app ---
  externalId String? @unique
  name       String
  type       String? // e.g. Tablet, Syrup, Injection
  price      Decimal @db.Decimal(12, 2)
  unit       String? @default("PCS")

  // --- Manual fields (billing-specific) ---
  hsnCode      String?
  gstRate      Decimal @default(0) @db.Decimal(5, 2) // e.g. 12.00 for 12%
  reorderLevel Int?    @default(0)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  batches Batch[]

  @@index([name])
}

model Batch {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  batchNumber String
  expiryDate  DateTime
  mrp         Decimal  @db.Decimal(12, 2)
  currentQty  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
}

// ============================================
// vouchers.prisma - Double Entry Vouchers
// ============================================

model FinancialYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers Voucher[]
}

model Voucher {
  id              String        @id @default(uuid())
  voucherNumber   String        @unique
  type            VoucherType
  date            DateTime
  narration       String?
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines VoucherLine[]
}

model VoucherLine {
  id        String    @id @default(uuid())
  voucherId String
  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId  String
  ledger    Ledger    @relation(fields: [ledgerId], references: [id])
  type      EntryType
  amount    Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
}
