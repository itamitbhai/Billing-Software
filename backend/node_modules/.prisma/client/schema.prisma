model LedgerGroup {
  id        String        @id @default(uuid())
  companyId String
  name      String
  nature    LedgerNature
  isSystem  Boolean       @default(false)
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ledgers   Ledger[]
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    LedgerGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children  LedgerGroup[] @relation("GroupHierarchy")

  @@unique([companyId, name])
  @@index([companyId])
}

model Ledger {
  id                 String        @id @default(uuid())
  companyId          String
  name               String
  groupId            String
  openingBalance     Decimal       @default(0) @db.Decimal(14, 2)
  openingBalanceType EntryType     @default(DEBIT)
  description        String?
  isSystem           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  bankAccount        BankAccount?
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group              LedgerGroup   @relation(fields: [groupId], references: [id])
  party              Party?
  voucherLines       VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([groupId])
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  gstin              String?
  pan                String?
  state              String
  address            String?
  phone              String?
  email              String?            @unique
  invoicePrefix      String             @default("INV")
  bankName           String?
  accountNo          String?
  ifscCode           String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dlNumber           String?
  auditLogs          AuditLog[]
  bankAccounts       BankAccount[]
  costCentres        CostCentre[]
  financialYears     FinancialYear[]
  ledgers            Ledger[]
  ledgerGroups       LedgerGroup[]
  parties            Party[]
  payments           Payment[]
  products           Product[]
  purchases          Purchase[]
  sales              Sale[]
  stockLedgerEntries StockLedgerEntry[]
  users              User[]
  vouchers           Voucher[]
  voucherSequences   VoucherSequence[]
  gstExports         GstExportHistory[]
}

model User {
  id           String             @id @default(uuid())
  companyId    String
  name         String
  email        String             @unique
  passwordHash String
  role         Role               @default(STAFF)
  isActive     Boolean            @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  auditLogs    AuditLog[]
  payments     Payment[]          @relation("RecordedBy")
  sessions     Session[]
  gstExports   GstExportHistory[]
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
}

model BankAccount {
  id              String               @id @default(uuid())
  companyId       String
  name            String
  ledgerId        String               @unique
  bankName        String
  accountNumber   String
  ifsc            String?
  branch          String?
  openingBalance  Decimal              @default(0) @db.Decimal(14, 2)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger          Ledger               @relation(fields: [ledgerId], references: [id])
  reconciliations BankReconciliation[]

  @@unique([companyId, accountNumber])
  @@index([companyId])
}

model BankReconciliation {
  id              String      @id @default(uuid())
  companyId       String
  bankAccountId   String
  voucherLineId   String      @unique
  statementDate   DateTime?
  statementAmount Decimal?    @db.Decimal(14, 2)
  isReconciled    Boolean     @default(false)
  reconciledAt    DateTime?
  createdAt       DateTime    @default(now())
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  voucherLine     VoucherLine @relation(fields: [voucherLineId], references: [id])

  @@index([bankAccountId])
  @@index([companyId])
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Purchase {
  id              String         @id @default(uuid())
  companyId       String
  financialYearId String
  supplierId      String
  billNumber      String
  purchaseDate    DateTime
  subTotal        Decimal        @db.Decimal(14, 2)
  gstAmount       Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal        @db.Decimal(14, 2)
  voucherId       String?        @unique
  isCancelled     Boolean        @default(false)
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  reverseCharge   Boolean        @default(false)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear  @relation(fields: [financialYearId], references: [id])
  supplier        Party          @relation(fields: [supplierId], references: [id])
  voucher         Voucher?       @relation(fields: [voucherId], references: [id])
  items           PurchaseItem[]

  @@unique([companyId, supplierId, billNumber])
  @@index([companyId, purchaseDate])
  @@index([companyId, supplierId, purchaseDate])
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  batchId      String
  qty          Int
  rate         Decimal  @db.Decimal(14, 2)
  gstAmount    Decimal  @default(0) @db.Decimal(14, 2)
  amount       Decimal  @db.Decimal(14, 2)
  cgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  gstRate      Decimal  @default(0) @db.Decimal(5, 2)
  hsnCode      String?
  igstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean  @default(true)
  sgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  taxableValue Decimal  @default(0) @db.Decimal(14, 2)
  productId    String
  batch        Batch    @relation(fields: [batchId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([batchId])
  @@index([productId])
}

model Sale {
  id              String        @id @default(uuid())
  companyId       String
  financialYearId String
  customerId      String
  invoiceNumber   String
  saleDate        DateTime
  subTotal        Decimal       @db.Decimal(14, 2)
  gstAmount       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  status          InvoiceStatus @default(UNPAID)
  voucherId       String?       @unique
  isCancelled     Boolean       @default(false)
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  placeOfSupply   String        @default("")
  supplyType      SupplyType    @default(TAXABLE)
  payments        Payment[]
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Party         @relation(fields: [customerId], references: [id])
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  items           SaleItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, saleDate])
  @@index([companyId, customerId, saleDate])
  @@index([companyId, status])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  batchId      String
  qty          Int
  rate         Decimal @db.Decimal(14, 2)
  gstAmount    Decimal @default(0) @db.Decimal(14, 2)
  amount       Decimal @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  hsnCode      String?
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  productId    String
  batch        Batch   @relation(fields: [batchId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([batchId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  partyId         String
  saleId          String?
  voucherId       String?       @unique
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  referenceNumber String?
  paymentDate     DateTime
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party           Party         @relation(fields: [partyId], references: [id])
  recordedBy      User?         @relation("RecordedBy", fields: [recordedById], references: [id])
  sale            Sale?         @relation(fields: [saleId], references: [id])
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])

  @@index([companyId, partyId])
  @@index([companyId, paymentDate])
  @@index([saleId])
}

model StockLedgerEntry {
  id            String             @id @default(uuid())
  companyId     String
  productId     String
  batchId       String
  movementType  StockMovementType
  referenceType StockReferenceType
  referenceId   String?
  qty           Int
  balanceQty    Int
  rate          Decimal            @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime           @default(now())
  batch         Batch              @relation(fields: [batchId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])

  @@index([companyId, productId, createdAt])
  @@index([batchId])
  @@index([referenceType, referenceId])
}

enum Role {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  RAZORPAY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum LedgerNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum EntryType {
  DEBIT
  CREDIT
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
  CREDIT_NOTE
  DEBIT_NOTE
}

enum StockMovementType {
  IN
  OUT
}

enum StockReferenceType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  OPENING
}

enum SupplyType {
  TAXABLE
  ZERO_RATED_EXPORT
  ZERO_RATED_SEZ
  EXEMPT
  NIL_RATED
  NON_GST
}

// GST return JSON exports. Invoices/notes are never copied here — only the
// generated files (so a download always returns exactly what was generated,
// even if source documents change later) and the validation outcome.
model GstExportHistory {
  id             String          @id @default(uuid())
  companyId      String
  returnType     String // GSTR1 | IFF
  frequency      String // MONTHLY | QUARTERLY
  financialYear  String // "2026-27"
  returnPeriod   String // GST fp, MMYYYY
  periodLabel    String
  gstin          String
  toolVersion    String // "version" written into the JSON, e.g. GST3.2.4
  schemaId       String // bundled JSON Schema the files were validated against
  recordCount    Int
  excludedCount  Int             @default(0)
  warningCount   Int             @default(0)
  fileCount      Int
  totalSizeBytes Int
  status         String // SCHEMA_VALID
  summary        Json // counts + totals shown in the preview
  issues         Json // validation issues at generation time (error report)
  createdById    String?
  createdAt      DateTime        @default(now())
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(fields: [createdById], references: [id])
  files          GstExportFile[]

  @@index([companyId, createdAt])
  @@index([companyId, returnType, returnPeriod])
}

model GstExportFile {
  id        String           @id @default(uuid())
  exportId  String
  partNo    Int
  fileName  String
  sizeBytes Int
  sha256    String
  content   String           @db.Text
  export    GstExportHistory @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@unique([exportId, partNo])
}

model Party {
  id               String     @id @default(uuid())
  companyId        String
  externalId       String?
  name             String
  gstin            String?
  pan              String?
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  type             PartyType  @default(CUSTOMER)
  creditLimit      Decimal?   @db.Decimal(14, 2)
  creditPeriodDays Int?       @default(30)
  openingBalance   Decimal    @default(0) @db.Decimal(14, 2)
  isActive         Boolean    @default(true)
  ledgerId         String     @unique
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dlNumber         String?
  idType           String     @default("DRUG_LICENSE")
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger           Ledger     @relation(fields: [ledgerId], references: [id])
  payments         Payment[]
  purchases        Purchase[]
  sales            Sale[]
  vouchers         Voucher[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, gstin])
}

model Product {
  id                 String             @id @default(uuid())
  companyId          String
  externalId         String?
  name               String
  sku                String?
  type               String?
  price              Decimal            @db.Decimal(14, 2)
  unit               String             @default("PCS")
  hsnCode            String?
  gstRate            Decimal            @default(0) @db.Decimal(5, 2)
  reorderLevel       Int                @default(0)
  isActive           Boolean            @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  batches            Batch[]
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, sku])
}

model Batch {
  id                 String             @id @default(uuid())
  companyId          String
  productId          String
  batchNumber        String
  expiryDate         DateTime
  mrp                Decimal            @db.Decimal(14, 2)
  currentQty         Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([productId, batchNumber])
  @@index([companyId, expiryDate])
}

model CostCentre {
  id           String        @id @default(uuid())
  companyId    String
  name         String
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       CostCentre?   @relation("CostCentreHierarchy", fields: [parentId], references: [id])
  children     CostCentre[]  @relation("CostCentreHierarchy")
  voucherLines VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
}

model FinancialYear {
  id        String            @id @default(uuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean           @default(false)
  isClosed  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  vouchers  Voucher[]
  sequences VoucherSequence[]

  @@unique([companyId, name])
  @@index([companyId])
}

model VoucherSequence {
  id              String        @id @default(uuid())
  companyId       String
  financialYearId String
  type            VoucherType
  lastNumber      Int           @default(0)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([companyId, financialYearId, type])
}

model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  voucherNumber   String
  type            VoucherType
  date            DateTime
  narration       String?
  partyId         String?
  financialYearId String
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payment         Payment?
  purchase        Purchase?
  sale            Sale?
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  party           Party?        @relation(fields: [partyId], references: [id])
  lines           VoucherLine[]

  @@unique([companyId, type, voucherNumber])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([partyId])
}

model VoucherLine {
  id             String              @id @default(uuid())
  voucherId      String
  ledgerId       String
  type           EntryType
  amount         Decimal             @db.Decimal(14, 2)
  cgstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  costCentreId   String?
  description    String?
  createdAt      DateTime            @default(now())
  reconciliation BankReconciliation?
  costCentre     CostCentre?         @relation(fields: [costCentreId], references: [id])
  ledger         Ledger              @relation(fields: [ledgerId], references: [id])
  voucher        Voucher             @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([ledgerId])
}
