// ============================================
// accounts.prisma - Chart of Accounts
// ============================================

model LedgerGroup {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  nature    LedgerNature
  isSystem  Boolean       @default(false)
  parentId  String?
  parent    LedgerGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children  LedgerGroup[] @relation("GroupHierarchy")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ledgers Ledger[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Ledger {
  id                 String      @id @default(uuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  groupId            String
  group              LedgerGroup @relation(fields: [groupId], references: [id])
  openingBalance     Decimal     @default(0) @db.Decimal(14, 2)
  openingBalanceType EntryType   @default(DEBIT)
  description        String?
  isSystem           Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  party        Party?
  bankAccount  BankAccount?
  voucherLines VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([groupId])
}

// ============================================
// auth.prisma - Companies, Users, Sessions, Audit Log
// ============================================

model Company {
  id            String   @id @default(uuid())
  name          String
  gstin         String?
  pan           String?
  state         String
  address       String?
  phone         String?
  email         String?  @unique
  invoicePrefix String   @default("INV")
  dlNumber      String? // Drug License No. (pharma statutory requirement, printed on GST invoices)
  bankName      String?
  accountNo     String?
  ifscCode      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              User[]
  parties            Party[]
  products           Product[]
  costCentres        CostCentre[]
  ledgerGroups       LedgerGroup[]
  ledgers            Ledger[]
  financialYears     FinancialYear[]
  voucherSequences   VoucherSequence[]
  vouchers           Voucher[]
  purchases          Purchase[]
  sales              Sale[]
  payments           Payment[]
  stockLedgerEntries StockLedgerEntry[]
  bankAccounts       BankAccount[]
  auditLogs          AuditLog[]
}

model User {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  payments  Payment[]  @relation("RecordedBy")
  auditLogs AuditLog[]

  @@index([companyId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================
// banking.prisma - Bank Accounts & Reconciliation
// ============================================

model BankAccount {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  ledgerId      String  @unique
  ledger        Ledger  @relation(fields: [ledgerId], references: [id])
  bankName      String
  accountNumber String
  ifsc          String?
  branch        String?

  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reconciliations BankReconciliation[]

  @@unique([companyId, accountNumber])
  @@index([companyId])
}

model BankReconciliation {
  id            String      @id @default(uuid())
  companyId     String
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  voucherLineId String      @unique
  voucherLine   VoucherLine @relation(fields: [voucherLineId], references: [id])

  statementDate   DateTime?
  statementAmount Decimal?  @db.Decimal(14, 2)
  isReconciled    Boolean   @default(false)
  reconciledAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([bankAccountId])
  @@index([companyId])
}

// ============================================================
// base.prisma — Database connection + Prisma Client config
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

// ============================================
// billing.prisma - Transactions, Payments, Stock Ledger
// ============================================

model Purchase {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  supplierId String
  supplier   Party  @relation(fields: [supplierId], references: [id])

  billNumber    String // supplier's own bill/invoice number
  purchaseDate  DateTime
  subTotal      Decimal  @db.Decimal(14, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  reverseCharge Boolean  @default(false) // GST payable by recipient under RCM (GSTR-3B 3.1(d))

  voucherId String?  @unique
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  isCancelled Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseItem[]

  @@unique([companyId, supplierId, billNumber])
  @@index([companyId, purchaseDate])
  @@index([companyId, supplierId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  qty       Int
  rate      Decimal @db.Decimal(14, 2)
  gstAmount Decimal @default(0) @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2) // qty * rate + gst

  // GST breakup (rate-wise, needed for GSTR-1/GSTR-3B — see SaleItem for rationale)
  hsnCode      String?
  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean @default(true) // false for blocked credits (e.g. motor vehicles, personal use)

  @@index([purchaseId])
  @@index([batchId])
}

model Sale {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  customerId String
  customer   Party  @relation(fields: [customerId], references: [id])

  invoiceNumber String // server-generated via VoucherSequence
  saleDate      DateTime
  subTotal      Decimal       @db.Decimal(14, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  status        InvoiceStatus @default(UNPAID)

  // GST return classification (GSTR-1/GSTR-3B) — snapshotted at creation so historical
  // returns stay correct even if the party's master state changes later.
  placeOfSupply String     @default("")
  supplyType    SupplyType @default(TAXABLE)

  voucherId String?  @unique
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  isCancelled Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    SaleItem[]
  payments Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, saleDate])
  @@index([companyId, customerId])
  @@index([companyId, status])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  qty       Int
  rate      Decimal @db.Decimal(14, 2)
  gstAmount Decimal @default(0) @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2) // qty * rate + gst

  // GST breakup (rate-wise) — a blended per-invoice gstAmount can't reconstruct a
  // rate-wise/HSN-wise return when an invoice mixes multiple GST rates, so each line
  // snapshots its own HSN, rate, and CGST/SGST/IGST split for GSTR-1/GSTR-3B reporting.
  hsnCode      String?
  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)

  @@index([saleId])
  @@index([batchId])
}

model Payment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  saleId String? // nullable - advance payments have no invoice yet
  sale   Sale?   @relation(fields: [saleId], references: [id])

  voucherId String?  @unique
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  referenceNumber String? // UPI txn id / cheque no / bank ref
  paymentDate     DateTime
  notes           String?

  recordedById String?
  recordedBy   User?   @relation("RecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, partyId])
  @@index([companyId, paymentDate])
  @@index([saleId])
}

// Source-of-truth audit trail for inventory movement.
// Batch.currentQty stays as a fast-read cache kept in sync in the same transaction.
model StockLedgerEntry {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
  batchId   String
  batch     Batch   @relation(fields: [batchId], references: [id])

  movementType  StockMovementType
  referenceType StockReferenceType
  referenceId   String? // Purchase.id / Sale.id / null for manual adjustment
  qty           Int
  balanceQty    Int // running balance snapshot after this entry
  rate          Decimal            @db.Decimal(14, 2)
  notes         String?

  createdAt DateTime @default(now())

  @@index([companyId, productId, createdAt])
  @@index([batchId])
  @@index([referenceType, referenceId])
}

// ============================================
// enums.prisma - Enums for B2B Medical Billing
// ============================================

enum Role {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  RAZORPAY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum LedgerNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum EntryType {
  DEBIT
  CREDIT
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
  CREDIT_NOTE
  DEBIT_NOTE
}

enum StockMovementType {
  IN
  OUT
}

enum StockReferenceType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  OPENING
}

enum SupplyType {
  TAXABLE
  ZERO_RATED_EXPORT
  ZERO_RATED_SEZ
  EXEMPT
  NIL_RATED
  NON_GST
}

// ============================================
// masters.prisma - Master data (Party, Product, Batch, Cost Centre)
// ============================================

model Party {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // --- Auto-fetched from existing VS Arogya app ---
  externalId String? // ID in the existing app, used to match on re-sync
  name       String
  gstin      String?
  pan        String?
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  pincode    String?
  dlNumber   String? // Buyer's Drug License No. (required on pharma GST invoices)

  // --- Manual fields (billing-specific, not in existing app) ---
  type             PartyType @default(CUSTOMER)
  creditLimit      Decimal?  @db.Decimal(14, 2)
  creditPeriodDays Int?      @default(30)
  openingBalance   Decimal   @default(0) @db.Decimal(14, 2)
  isActive         Boolean   @default(true)

  // Backing Ledger Link
  ledgerId String @unique
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchases Purchase[]
  sales     Sale[]
  payments  Payment[]
  vouchers  Voucher[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, gstin])
}

model Product {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // --- Auto-fetched from existing VS Arogya app ---
  externalId String?
  name       String
  sku        String?
  type       String? // e.g. Tablet, Syrup, Injection
  price      Decimal @db.Decimal(14, 2)
  unit       String  @default("PCS")

  // --- Manual fields (billing-specific) ---
  hsnCode      String?
  gstRate      Decimal @default(0) @db.Decimal(5, 2) // e.g. 12.00 for 12%
  reorderLevel Int     @default(0)
  isActive     Boolean @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  batches            Batch[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
  @@index([companyId, sku])
}

model Batch {
  id        String  @id @default(uuid())
  companyId String // denormalized from product.companyId - fast expiry-alert queries without a join
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNumber String
  expiryDate  DateTime
  mrp         Decimal  @db.Decimal(14, 2)
  currentQty  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([productId, batchNumber])
  @@index([companyId, expiryDate])
}

model CostCentre {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    CostCentre?  @relation("CostCentreHierarchy", fields: [parentId], references: [id])
  children  CostCentre[] @relation("CostCentreHierarchy")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  voucherLines VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================
// vouchers.prisma - Double Entry Vouchers
// ============================================

model FinancialYear {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isClosed  Boolean  @default(false) // blocks new postings once the year is closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers  Voucher[]
  sales     Sale[]
  purchases Purchase[]
  sequences VoucherSequence[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Atomic per-(company, financial year, type) counter — avoids the
// count()-then-pad race condition that produced duplicate voucher numbers.
model VoucherSequence {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  type            VoucherType
  lastNumber      Int           @default(0)

  @@unique([companyId, financialYearId, type])
}

model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherNumber   String
  type            VoucherType
  date            DateTime
  narration       String?
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  isDeleted Boolean   @default(false) // cancelled, never hard-deleted
  deletedAt DateTime?
  deletedBy String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    VoucherLine[]
  sale     Sale?
  purchase Purchase?
  payment  Payment?

  @@unique([companyId, type, voucherNumber])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([partyId])
}

model VoucherLine {
  id           String      @id @default(uuid())
  voucherId    String
  voucher      Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId     String
  ledger       Ledger      @relation(fields: [ledgerId], references: [id])
  type         EntryType
  amount       Decimal     @db.Decimal(14, 2)
  cgstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  costCentreId String?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])
  description  String?
  createdAt    DateTime    @default(now())

  reconciliation BankReconciliation?

  @@index([voucherId])
  @@index([ledgerId])
}
