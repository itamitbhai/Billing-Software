# ── Dependencies ──────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment secrets (never commit real .env files) ─────────
.env
.env.*
!.env.example
!**/.env.example
# frontend/.env.production only holds the public API base URL, not a secret
!frontend/.env.production

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
**/dist/
**/build/

# ── Logs ─────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Prisma / DB ──────────────────────────────────────────────
backend/prisma/*.db
backend/prisma/dev.db*

# ── Editor / OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
